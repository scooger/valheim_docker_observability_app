# Copy to .env by running: sudo bash scripts/setup.sh
# The server password must be at least 5 characters or Valheim will refuse to start.

# Name shown in the in-game server list.
SERVER_NAME=Valheim

# World file name, without .db / .fwl. Must match an existing world if you import one.
WORLD_NAME=Valheim

# Replace this before starting. setup.sh generates a random password on first run.
SERVER_PASS=change-me

# false keeps the server off the Steam / community browser.
# Friends join by IP and still need SERVER_PASS.
SERVER_PUBLIC=false

# UDP game port. 2457 (query) and 2458 (crossplay) are published alongside it.
SERVER_PORT=2456

# true allows Xbox / Microsoft Store clients and uses PlayFab. Steam-only groups
# should leave this false. See README for the CGNAT workaround.
CROSSPLAY=false

# Cron inside the container. Uses TZ.
TZ=America/New_York

# Check for Valheim updates on this schedule, and only apply them when nobody is online.
UPDATE_CRON=*/30 * * * *
UPDATE_IF_IDLE=true

# Daily restart only when the server is empty. Empty string disables it.
RESTART_CRON=10 5 * * *
RESTART_IF_IDLE=true

BACKUPS=true
BACKUPS_CRON=5 * * * *
BACKUPS_MAX_AGE=7
BACKUPS_MAX_COUNT=48
BACKUPS_IF_IDLE=true

# Linux user that owns world files on the host. setup.sh sets these to the valheim user.
PUID=1000
PGID=1000

# Mod framework. Use BepInEx for Thunderstore plugins (Jotunn, NetworkPerformanceSystem).
# Do not enable VALHEIM_PLUS at the same time.
BEPINEX=true
VALHEIM_PLUS=false
